datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
id        Int       @id @default(autoincrement())
email     String    @unique
name      String?
password  String
telephone String?
createdAt DateTime  @default(now())
updatedAt DateTime  @updatedAt
role      Role
}

enum Role {
  USER
  ADMIN
}